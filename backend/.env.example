# Database
# If running via docker-compose: postgresql+asyncpg://watchme:watchme@localhost:5432/watchme
# If running native Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/WatchMe
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/WatchMe

# TMDB (get free API key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Groq (free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# FCM (Firebase Console service account JSON path)
FCM_CREDENTIALS_PATH=path/to/firebase-adminsdk.json

# App settings (e.g. 20 for active dev/testing, 3600 for prod)
NOTIFICATION_INTERVAL_SECONDS=3600
DEBUG=false
