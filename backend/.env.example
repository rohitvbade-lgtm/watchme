# ==============================================================================
# WatchMe Production Environment Configuration ($0 Zero Cost Deployment)
# ==============================================================================

# Database: Supabase PostgreSQL (Free Tier)
# Option A (Recommended for IPv4 compatibility): Supavisor Session Pooler (port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
# Option B: Direct Connection (port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require
# Option C: Local Docker PostgreSQL (Dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/WatchMe

# TMDB (Free API Key: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Groq (Free Tier LLM: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# FCM (Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# Place the file on your server and reference the path:
FCM_CREDENTIALS_PATH=watchme-firebase-adminsdk.json

# Caddy Reverse Proxy & Automated HTTPS (Oracle Cloud VM)
DOMAIN_NAME=your-app.duckdns.org
ACME_EMAIL=your-email@example.com

# Security & Traffic Protection
# API_SECRET_KEY: Optional shared secret header (x-api-key). If set, only clients with this key can call /api endpoints.
API_SECRET_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=40

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=https://localhost,capacitor://localhost,ionic://localhost,http://localhost:4200,http://localhost:8100

# Scheduler & Debugging (Use 3600s for production)
NOTIFICATION_INTERVAL_SECONDS=3600
DEBUG=false

